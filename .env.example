# ================= Altcoin Faucet configuration =================
# Copy to .env and fill in real values. NEVER commit .env.
#
# This faucet is coin-agnostic. To serve a different coin, change the COIN_*
# block and point the daemon RPC at the right place — nothing else.
# (Legacy DVC_RPC_URL / DVC_RPC_USER / DVC_RPC_PASSWORD names are still read.)

# ---- HTTP ----
PORT=8080

# ---- Coin display ----
COIN_NAME=Devcoin            # full name shown in the UI
COIN_TICKER=DVC              # ticker shown next to amounts
COIN_DECIMALS=8              # smallest unit per coin (bitcoin-style = 8)

# ---- Coin daemon JSON-RPC (bitcoin-core compatible) ----
COIN_RPC_URL=http://127.0.0.1:52332
COIN_RPC_USER=devcoinrpc
COIN_RPC_PASSWORD=change-me-rpc-password
COIN_RPC_TIMEOUT_MS=15000
# How the faucet reads donations received for the label/address:
#   label   -> getreceivedbylabel   (bitcoin-core >= 0.17)
#   account -> getreceivedbyaccount (older forks, Devcoin-era daemons)
#   none    -> skip the balance check entirely (funds never auto-pay)
COIN_BALANCE_MODE=label

# ---- MySQL (compose creates everything for you) ----
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=faucet
DB_USER=faucet
DB_PASSWORD=change-me-strong-password
DB_POOL_SIZE=4

# ---- Donation wallet display ----
DONATION_LABEL=FaucetDonations
DONATION_ADDRESS=1EpJKJbpeoXnYGtoB8F6re78FMAtvNRWMf

# ---- Google reCAPTCHA v3 ----
# https://www.google.com/recaptcha/admin
RECAPTCHA_SITE_KEY=your_recaptcha_site_key
RECAPTCHA_SECRET_KEY=your_recaptcha_secret_key
RECAPTCHA_MIN_SCORE=0.5
# Optional: comma-separated hostnames the token must have been issued for.
RECAPTCHA_ALLOWED_HOSTNAMES=

# ---- Faucet behaviour ----
# Claims needed to fill one round.
ROUND_SIZE=30
# Single payout (whole coins) used when seeding round #1 (admin can change it later).
INITIAL_SINGLEPAY=2000
# Extra coins the wallet must hold above the batch total (mining fee headroom).
FEE_RESERVE=0

# ---- Admin panel login (set a strong password) ----
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-admin-password
ADMIN_SESSION_TTL_MS=43200000

# Secret used to sign admin session cookies (>=16 chars).
SESSION_SECRET=change-me-to-a-long-random-string

# ---- Reverse proxies we TRUST when reading X-Forwarded-For ----
# Comma-separated IPv4 CIDRs of YOUR OWN proxies only (e.g. docker bridge nets).
# Empty = no proxy trust; the socket address is used as the client IP.
# Requests from any other source have their X-Forwarded-For ignored.
TRUSTED_PROXY_CIDRS=

# ---- Tuning ----
STATS_CACHE_TTL_MS=30000

# ---- Proxy deployment (only when using compose.prod.yml) ----
# VIRTUAL_HOST=faucet.example.com
# LETSENCRYPT_EMAIL=you@example.com
