# One-shot migration runner. Needs DB_* vars pointing at a MySQL user with DDL rights.
FROM node:22-alpine
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci
COPY tsconfig.json ./
COPY src ./src
COPY scripts ./scripts
COPY migrations ./migrations
ENTRYPOINT ["npx", "tsx", "scripts/migrate.ts"]
